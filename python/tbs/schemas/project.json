{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "epoch", "sites", "links"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "epoch": {"type": "string", "format": "date-time"},
    "sites": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "config"],
      "properties": {"id": {"type": "string"}, "config": {"type": "string", "minLength": 1}}
    }},
    "links": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "distance_m"],
      "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "distance_m": {"type": "number", "exclusiveMinimum": 0}}
    }}
  }
}
